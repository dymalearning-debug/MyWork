# Copy this file to .env.local and fill in the values.
# Supabase dashboard > Project Settings > API Keys (and Data API for the URL). Development and previews:
# project "MyWork Dev" (othjqrfcmbvzfexkvjml); production: project "MyWork" (ulufanywmrporutivwgc).
NEXT_PUBLIC_SUPABASE_URL=https://othjqrfcmbvzfexkvjml.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret key (same page, "Secret keys"): end-to-end tests only, to create and delete test accounts.
# Never prefix it with NEXT_PUBLIC_, never use it in the app. Also stored in the GitHub secrets.
SUPABASE_SECRET_KEY=sb_secret_...

# LiveKit Cloud, project MyWork (p_55iutdslog4), EU region (Frankfurt): video calls of the Booking module.
# LiveKit Cloud > Settings > API keys. Server only: never prefix with NEXT_PUBLIC_.
LIVEKIT_URL=wss://mywork-2u2z4y18.livekit.cloud
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=...

# Resend (domain hellomywork.com, region Ireland): all the emails. Resend > API keys ("Sending
# access", this domain only). Used by the app and by `npx supabase config push` (SMTP password).
RESEND_API_KEY=re_...

# Secret of the Rendez-vous module (docs/booking.md, "E-mails" and "Protection contre les abus"):
# the email queue and the bookings, which the database only takes from the server. Random, its SHA-256 is in the
# table private.secret_hashes of each database (migration 20261023120000). Server only.
BOOKING_EMAILS_SECRET=...

# Stripe (subscriptions). Stripe > Developers > API keys. Test key (sk_test_) in Development and Preview,
# live key (sk_live_) in Production only. Server only: never prefix with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_...
# Development: given by the Stripe CLI, `stripe listen --print-secret` (stable for this account).
# Production: secret of the live webhook endpoint (Stripe > Developers > Webhooks).
STRIPE_WEBHOOK_SECRET=whsec_...

# Secret of the subscription writes (docs/billing.md, "En coulisses"): random, its SHA-256 is in the
# table private.secret_hashes of each database (migration 20261023120000), not the same in production. Server only.
BILLING_SECRET=...
